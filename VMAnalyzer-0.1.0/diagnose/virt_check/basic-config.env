# global config file : config.env

#[kernel]
Kernel_regex="[[:digit:]]{0,100}\.[[:digit:]]{0,100}\.[[:digit:]]{0,100}\-[[:digit:]]{0,3000}\.[[:digit:]]{0,500}"

#[EV_version]
version_regex="[[:digit:]]{0,100}\.[[:digit:]]{0,100}\.[[:digit:]]{0,100}\-[[:digit:]]{0,100}\.[[:digit:]]{0,100}"

#[EV_config]
Open_Files="1000000"

#[transparent_hugepage]
THP_flag="always"

#[Mem_Frequency]
## The difference that allows for Memory frequency drops 
Mem_Frequency="50"

#[Dom_schedinfo]
schedinfo="cpu_shares vcpu_period vcpu_quota emulator_period emulator_quota iothread_period"
cpu_shares=1024
vcpu_period=100000
vcpu_quota=-1
emulator_period=100000
emulator_quota=-1
iothread_period=100000
iothread_quota=-1

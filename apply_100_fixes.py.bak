fix("fix-stats-aggregation-empty",
    "agent/stats_aggregation.py",
    """#!/usr/bin/env python3
# Copyright (c) 2025 China Mobile (SuZhou). VMAnalyzer Mulan PSL v2.
\"\"\"Aggregate collected stats over time windows.\"\"\"
import logging, time
LOG=logging.getLogger(__name__)

class StatsAggregator:
    def __init__(self,window_sizes=[60,300,3600]):
        self.windows={s:[] for s in window_sizes}
    def add_sample(self,vm_name,metric,value,ts=None):
        if ts is None: ts=time.time()
        for w in self.windows:
            self.windows[w].append({"vm":vm_name,"metric":metric,"value":value,"ts":ts})
    def get_average(self,vm_name,metric,window):
        now=time.time()
        samples=[s for s in self.windows.get(window,[]) if s["vm"]==vm_name and s["metric"]==metric and now-s["ts"]<=window]
        if not samples: return None
        return sum(s["value"] for s in samples)/len(samples)
    def cleanup(self):
        now=time.time()
        for w in self.windows:
            self.windows[w]=[s for s in self.windows[w] if now-s["ts"]<=w*2]""",
    """#!/usr/bin/env python3
# Copyright (c) 2025 China Mobile (SuZhou). VMAnalyzer Mulan PSL v2.
\"\"\"Aggregate collected stats over time windows.\"\"\"
import logging, time, threading
LOG=logging.getLogger(__name__)

class StatsAggregator:
    def __init__(self, window_sizes=None):
        if window_sizes is None:
            window_sizes = [60, 300, 3600]
        self.windows = {s: [] for s in window_sizes}
        self._lock = threading.Lock()
    
    def add_sample(self, vm_name, metric, value, ts=None):
        if ts is None:
            ts = time.time()
        with self._lock:
            for w in self.windows:
                self.windows[w].append({"vm": vm_name, "metric": metric, "value": value, "ts": ts})
    
    def get_average(self, vm_name, metric, window):
        now = time.time()
        with self._lock:
            samples = [s for s in self.windows.get(window, [])
                      if s["vm"] == vm_name and s["metric"] == metric and now - s["ts"] <= window]
        if not samples:
            return None
        return sum(s["value"] for s in samples) / len(samples)
    
    def cleanup(self):
        now = time.time()
        with self._lock:
            for w in self.windows:
                self.windows[w] = [s for s in self.windows[w] if now - s["ts"] <= w * 2]""")


    """#!/usr/bin/env python3
# Copyright (c) 2025 China Mobile (SuZhou). VMAnalyzer Mulan PSL v2.
\"\"\"Persist collection session state to survive restarts.\"\"\"
import json, os, logging, time, tempfile, shutil
LOG=logging.getLogger(__name__)

class SessionPersistence:
    def __init__(self, state_file="/var/lib/vmanalyzer/session_state.json"):
        self.file = state_file
        self.data = self._load()
    
    def save_timestamp(self, vm_name, metric, ts):
        self.data.setdefault(vm_name, {})[metric] = ts
        self._save()
    
    def get_last_timestamp(self, vm_name, metric):
        return self.data.get(vm_name, {}).get(metric)
    
    def _load(self):
        if os.path.exists(self.file):
            try:
                with open(self.file) as f:
                    return json.load(f)
            except (json.JSONDecodeError, OSError):
                return {}
        return {}
    
    def _save(self):
        os.makedirs(os.path.dirname(self.file), exist_ok=True)
        tmp = self.file + ".tmp"
        try:
            with open(tmp, "w") as f:
                json.dump(self.data, f)
            shutil.move(tmp, self.file)
        except OSError as e:
            LOG.error("Failed to save session state: %s", e)""")


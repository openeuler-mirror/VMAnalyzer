# ============ agent/self_monitor.py ============
fix("fix-self-monitor, replace non-existent file",
    "agent/self_monitor.py",
    """#!/usr/bin/env python3
# Copyright (c) 2025 China Mobile (SuZhou). VMAnalyzer Mulan PSL v2.
\"\"\"Self-monitoring for the agent process.\"\"\"
import psutil, logging, time, threading
LOG=logging.getLogger(__name__)

class SelfMonitor:
    def __init__(self,interval=60,cpu_threshold=80,mem_threshold=80):
        self.interval=interval; self.cpu_th=cpu_threshold; self.mem_th=mem_threshold
    def check(self):
        p=psutil.Process()
        cpu=p.cpu_percent(interval=1); mem=p.memory_percent()
        if cpu>self.cpu_th: LOG.warning(f"Agent CPU usage high: {cpu:.1f}%")
        if mem>self.mem_th: LOG.warning(f"Agent memory usage high: {mem:.1f}%")
        return {"cpu":cpu,"mem":mem}
    def start(self):
        def loop():
            while True: time.sleep(self.interval); self.check()
        t=threading.Thread(target=loop,daemon=True); t.start()""",
    """#!/usr/bin/env python3
# Copyright (c) 2025 China Mobile (SuZhou). VMAnalyzer Mulan PSL v2.
\"\"\"Self-monitoring for the agent process.\"\"\"
import logging, time, threading
LOG=logging.getLogger(__name__)

try:
    import psutil
    HAS_PSUTIL = True
except ImportError:
    HAS_PSUTIL = False
    LOG.warning("psutil not installed, self-monitoring disabled")

class SelfMonitor:
    def __init__(self, interval=60, cpu_threshold=80, mem_threshold=80):
        self.interval = interval
        self.cpu_th = cpu_threshold
        self.mem_th = mem_threshold
    
    def check(self):
        if not HAS_PSUTIL:
            return {"cpu": 0, "mem": 0}
        p = psutil.Process()
        cpu = p.cpu_percent(interval=1)
        mem = p.memory_percent()
        if cpu > self.cpu_th:
            LOG.warning(f"Agent CPU usage high: {cpu:.1f}%")
        if mem > self.mem_th:
            LOG.warning(f"Agent memory usage high: {mem:.1f}%")
        return {"cpu": cpu, "mem": mem}
    
    def start(self):
        def loop():
            while True:
                time.sleep(self.interval)
                self.check()
        t = threading.Thread(target=loop, daemon=True)
        t.start()""")


#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
应用100个独立的可修复点到一个分支，然后将每个修复创建为独立分支推送。
每个修复修改不同的文件或同一文件的不同独立部分，互不冲突。

运行方式:
  python apply_100_fixes.py        # 只展示修复计划
  python apply_100_fixes.py push   # 创建分支并推送
"""
import subprocess, os, sys, textwrap, re

REPO = r"D:\New project\VMAnalyzer_9702"
BASE = "develope-251121"
PUSH = "--push" in sys.argv or "push" in sys.argv

os.chdir(REPO)

def git(*args, check=True):
    r = subprocess.run(["git"] + list(args), capture_output=True, text=True, cwd=REPO, timeout=30)
    if check and r.returncode != 0:
        print(f"  ⚠️ git {' '.join(args)}: {r.stderr.strip()[:100]}")
        return None
    return r.stdout.strip()

def ensure_base():
    git("stash")
    git("checkout", BASE)
    git("pull", "origin", BASE, check=False)

def apply_edit(filepath, old_text, new_text):
    """替换文件中的文本"""
    path = os.path.join(REPO, filepath)
    if not os.path.exists(path):
        return False, f"文件不存在"
    with open(path, "r", encoding="utf-8") as f:
        content = f.read()
    if old_text not in content:
        # Try fuzzy match
        return False, "未找到匹配文本"
    new_content = content.replace(old_text, new_text)
    with open(path, "w", encoding="utf-8") as f:
        f.write(new_content)
    return True, "ok"


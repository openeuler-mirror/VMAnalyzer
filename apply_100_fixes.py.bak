fix("fix-shutdown-handler-register-order",
    "agent/shutdown_handler.py",
    """#!/usr/bin/env python3
# Copyright (c) 2025 China Mobile (SuZhou). VMAnalyzer Mulan PSL v2.
\"\"\"Graceful shutdown of collector components.\"\"\"
import signal, logging
LOG=logging.getLogger(__name__)

class ShutdownHandler:
    def __init__(self):
        self.hooks=[]
        signal.signal(signal.SIGINT,self._handle)
        signal.signal(signal.SIGTERM,self._handle)
    def register(self,func):
        self.hooks.append(func)
    def _handle(self,sig,frame):
        LOG.info(f"Received signal {sig}, shutting down...")
        for hook in self.hooks:
            try: hook()
            except Exception as e: LOG.error(f"Shutdown hook failed: {e}")
        raise SystemExit(0)""",
    """#!/usr/bin/env python3
# Copyright (c) 2025 China Mobile (SuZhou). VMAnalyzer Mulan PSL v2.
\"\"\"Graceful shutdown of collector components.\"\"\"
import signal, logging, os
LOG=logging.getLogger(__name__)

class ShutdownHandler:
    def __init__(self):
        self.hooks = []
        self._installed = False
    
    def install(self):
        if self._installed:
            return
        signal.signal(signal.SIGINT, self._handle)
        signal.signal(signal.SIGTERM, self._handle)
        self._installed = True
    
    def register(self, func):
        self.hooks.append(func)
        if not self._installed:
            self.install()
    
